<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <RootNamespace>EdB.PrepareCarefully</RootNamespace>
    <AssemblyName>EdBPrepareCarefully</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">Libraries\Harmony\1.7\0Harmony.dll</HarmonyPath>
    <Harmony16Path Condition="'$(Harmony16Path)' == ''">Libraries\Harmony\1.6\0Harmony.dll</Harmony16Path>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Source\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" Condition="'$(RimWorld16ManagedDir)' == ''" />
    <Reference Include="Assembly-CSharp" Condition="'$(RimWorld16ManagedDir)' != ''">
      <HintPath>$(RimWorld16ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.InputLegacyModule;UnityEngine.TextRenderingModule" Condition="'$(RimWorld16ManagedDir)' != ''">
      <HintPath>$(RimWorld16ManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Harmony16Path)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TargetFramework)' == 'net10.0' and !Exists('$(RimWorldDir)\Assembly-CSharp.dll')" Text="Set RimWorldDir (or RIMWORLD_DIR) to your RimWorld 1.7 installation directory." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' and !Exists('$(RimWorldDir)\UnityStubs.dll')" Text="RimWorld 1.7 UnityStubs.dll was not found in RimWorldDir." />
    <Error Condition="'$(TargetFramework)' == 'net10.0' and !Exists('$(HarmonyPath)')" Text="Set HarmonyPath to the Harmony 1.7 mod's 0Harmony.dll." />
    <Error Condition="'$(TargetFramework)' == 'net472' and !Exists('$(Harmony16Path)')" Text="Set Harmony16Path to the Harmony 1.6 mod's 0Harmony.dll." />
    <Error Condition="'$(TargetFramework)' == 'net472' and '$(RimWorld16ManagedDir)' != '' and !Exists('$(RimWorld16ManagedDir)\Assembly-CSharp.dll')" Text="RimWorld16ManagedDir must point to RimWorld 1.6's RimWorldWin64_Data/Managed directory." />
  </Target>
  <Target Name="Dist" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Distribution requires Configuration=Release." />
    <Error Condition="'$(TargetFramework)' != ''" Text="Distribution requires both frameworks. Do not set TargetFramework for Dist." />
    <PropertyGroup>
      <DistDir>$(MSBuildProjectDirectory)\dist\EdBPrepareCarefully</DistDir>
      <Assembly16>$(MSBuildProjectDirectory)\bin\Release\net472\EdBPrepareCarefully.dll</Assembly16>
      <Assembly17>$(MSBuildProjectDirectory)\bin\Release\net10.0\EdBPrepareCarefully.dll</Assembly17>
    </PropertyGroup>
    <Error Condition="!Exists('$(Assembly16)') or !Exists('$(Assembly17)')" Text="Both RimWorld 1.6 and 1.7 Release assemblies are required for distribution." />
    <ItemGroup>
      <DistResource Include="Resources\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(DistDir)" />
    <Copy SourceFiles="@(DistResource)" DestinationFiles="@(DistResource->'$(DistDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="LICENSE;THIRD-PARTY-LICENSES" DestinationFolder="$(DistDir)" />
    <Copy SourceFiles="$(Assembly16)" DestinationFolder="$(DistDir)\1.6\Assemblies" />
    <Copy SourceFiles="$(Assembly17)" DestinationFolder="$(DistDir)\1.7\Assemblies" />
    <Message Importance="high" Text="Distribution created (RimWorld 1.6 + 1.7): $(DistDir)" />
  </Target>
</Project>
